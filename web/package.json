{
  "name": "web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e",
    "data:sync": "node scripts/sync-data.mjs",
    "data:mock": "npm run data:sync",
    "build:geo": "tsx scripts/geo/build-provinces.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "pretest:e2e": "npm run data:sync && python ../scripts/build_references.py",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "predev": "npm run data:sync",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:release": "python ../scripts/build_references.py && python ../scripts/check_no_mock.py ../data/processed public/data --content src/content --references public/data/references.json && tsc --noEmit && vite build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/echarts": "^4.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-simplify": "3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "^29.1.1",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
