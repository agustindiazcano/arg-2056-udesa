{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelParams",
  "description": "Registry of parameter definitions, distributions, and sources for the Argentina 2056 forecasting model.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "symbol",
      "value",
      "unit",
      "distribution",
      "low",
      "high",
      "source_id",
      "assumption",
      "justification",
      "component",
      "role",
      "needs_source",
      "assumption_id"
    ],
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z]{2,4}\\.[a-zA-Z0-9_]+$"
      },
      "symbol": {
        "type": "string",
        "minLength": 1
      },
      "value": {
        "type": ["number", "null"]
      },
      "unit": {
        "type": "string",
        "minLength": 1
      },
      "distribution": {
        "type": "string",
        "enum": ["fixed", "truncated_normal", "triangular", "uniform"]
      },
      "low": {
        "type": ["number", "null"]
      },
      "high": {
        "type": ["number", "null"]
      },
      "source_id": {
        "type": ["string", "null"],
        "pattern": "^[a-z0-9_-]+:[A-Za-z0-9_.-]+$"
      },
      "assumption": {
        "type": "boolean"
      },
      "justification": {
        "type": "string",
        "minLength": 1
      },
      "component": {
        "type": "string",
        "enum": ["population", "growth", "hdi", "resources", "provinces", "ai"]
      },
      "role": {
        "type": "string",
        "enum": ["fixed", "calibrated", "random"]
      },
      "needs_source": {
        "type": "boolean"
      },
      "assumption_id": {
        "type": ["string", "null"],
        "pattern": "^A[0-9]{2}$"
      }
    },
    "oneOf": [
      {
        "description": "State: sourced",
        "properties": {
          "source_id": { "type": "string" },
          "assumption": { "const": false },
          "needs_source": { "const": false }
        }
      },
      {
        "description": "State: assumption",
        "properties": {
          "source_id": { "type": "null" },
          "assumption": { "const": true },
          "needs_source": { "const": false }
        }
      },
      {
        "description": "State: needs_source",
        "properties": {
          "source_id": { "type": "null" },
          "assumption": { "const": false },
          "needs_source": { "const": true },
          "value": { "type": "null" },
          "low": { "type": "null" },
          "high": { "type": "null" }
        }
      }
    ],
    "allOf": [
      {
        "if": {
          "properties": { "role": { "enum": ["fixed", "calibrated"] } }
        },
        "then": {
          "properties": { "distribution": { "const": "fixed" } }
        }
      },
      {
        "if": {
          "properties": { "role": { "const": "random" } }
        },
        "then": {
          "properties": { "distribution": { "enum": ["truncated_normal", "triangular", "uniform"] } }
        }
      },
      {
        "if": {
          "properties": {
            "role": { "const": "random" },
            "needs_source": { "const": false }
          }
        },
        "then": {
          "properties": {
            "low": { "type": "number" },
            "high": { "type": "number" }
          }
        }
      }
    ]
  }
}
