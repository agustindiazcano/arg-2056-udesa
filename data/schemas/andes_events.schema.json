{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "day_of_campaign": { "type": "integer", "minimum": -30, "maximum": 365 },
      "column_id": { "type": "string", "minLength": 1 },
      "column_name": { "type": "string", "minLength": 1 },
      "date": { "type": "string", "format": "date" },
      "date_precision": { "type": "string", "enum": ["day", "month", "year", "approximate"] },
      "lat": { "type": "number" },
      "lon": { "type": "number" },
      "elevation_m": { "type": ["number", "null"] },
      "forces": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "side": { "type": "string" },
            "men": { "type": ["integer", "null"] },
            "note": { "type": "string" }
          },
          "required": ["side", "men"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "men": { "type": "null" } } },
              "then": { "required": ["note"] }
            }
          ]
        }
      },
      "estimate_range": {
        "type": "object",
        "properties": {
          "min": { "type": "number" },
          "max": { "type": "number" }
        },
        "required": ["min", "max"],
        "additionalProperties": false
      },
      "outcome": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "minLength": 1 },
          "sides": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "side": { "type": "string" },
                "units": { "type": "string" },
                "killed": { "type": ["integer", "null"] },
                "wounded": { "type": ["integer", "null"] },
                "prisoners": { "type": ["integer", "null"] },
                "note": { "type": "string" }
              },
              "required": ["side", "units", "killed", "wounded", "prisoners"],
              "additionalProperties": false
            }
          }
        },
        "required": ["result", "sides"],
        "additionalProperties": false
      },
      "source": { "type": "string", "minLength": 1 },
      "retrieved_at": { "type": "string", "format": "date" },
      "note": { "type": "string" }
    },
    "required": [
      "id",
      "name",
      "day_of_campaign",
      "date",
      "date_precision",
      "lat",
      "lon",
      "elevation_m",
      "forces",
      "source",
      "retrieved_at"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": { "properties": { "elevation_m": { "type": "null" } } },
        "then": { "required": ["note"] }
      }
    ]
  }
}
