{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "geo": { "type": "string", "pattern": "^(AR|AR-[A-Z])$" },
      "year": { "type": "integer" },
      "age": { "type": "integer", "minimum": 0, "maximum": 100 },
      "shape_m": {
        "anyOf": [
          { "type": "number" },
          { "type": "null" }
        ]
      },
      "net_migrants": {
        "anyOf": [
          { "type": "number" },
          { "type": "null" }
        ]
      },
      "source": { "type": "string", "minLength": 1 },
      "retrieved_at": { "type": "string", "format": "date" },
      "note": { "type": "string" }
    },
    "required": [
      "geo",
      "year",
      "age",
      "shape_m",
      "net_migrants",
      "source",
      "retrieved_at"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": { "properties": { "shape_m": { "type": "null" } } },
        "then": { "required": ["note"] }
      },
      {
        "if": { "properties": { "net_migrants": { "type": "null" } } },
        "then": { "required": ["note"] }
      }
    ]
  }
}
